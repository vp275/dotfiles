<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vp.aerospace-sticky</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-n</string>
    <string>/Users/vp/Applications/AeroSpace Sticky.app</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>StandardOutPath</key>
  <string>/Users/vp/Library/Logs/aerospace-sticky.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/vp/Library/Logs/aerospace-sticky.launchd.err.log</string>
</dict>
</plist>
